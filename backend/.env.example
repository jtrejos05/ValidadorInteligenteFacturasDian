# Copy to backend/.env. Without an API key the app runs with the deterministic mock LLM.
# ANTHROPIC_API_KEY=sk-ant-...
DIAN_LLM_PROVIDER=auto          # auto | anthropic | mock
DIAN_LLM_MODEL=claude-opus-5-5
DIAN_LLM_EFFORT=low             # low | medium | high
DIAN_MANUAL_MINUTES_PER_INVOICE=6
DIAN_ANALYST_COST_COP_PER_HOUR=35000
